#!/bin/sh
set -e

# If the custom dashboard is currently the active screen, switch back to
# the stock gl_screen UI before removing its files, so uninstalling never
# leaves the physical screen blank or crash-looping.
if [ -x /etc/init.d/mudi7-dashboard ] &&
    { /etc/init.d/mudi7-dashboard enabled || /etc/init.d/mudi7-dashboard running; } 2>/dev/null; then
    /usr/libexec/mudi7-customizer/toggle.sh off || true
fi

/etc/init.d/batterycontrol stop 2>/dev/null || true
/etc/init.d/batterycontrol disable 2>/dev/null || true

/etc/init.d/homebutton stop 2>/dev/null || true
/etc/init.d/homebutton disable 2>/dev/null || true

exit 0
