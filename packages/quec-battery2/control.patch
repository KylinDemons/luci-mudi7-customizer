+static void test_cached_irq_count(void)
+{
+    char root[] = "/tmp/qb-irq-test-XXXXXX";
+    char directory[96];
+    char path[128];
+    unsigned long long count;
+    int irq = -1;
+
+    assert(mkdtemp(root) != NULL);
+    snprintf(directory, sizeof(directory), "%s/151/", root);
+    assert(mkdir(directory, 0700) == 0);
+    snprintf(path, sizeof(path), "%s/interrupts", root);
+    write_test_file(root, "/interrupts", " 151: 7 3 0 0 msmgpio 19 Edge 2-006f\n");
+
+    assert(qb_read_irq_count_cached(path, root, QB_SGM41600_IRQ_LABEL,
+                                    &irq, &count) == 0);
+    assert(irq == -1 && count == 10);
+
+    write_test_file(directory, "actions", "2-006f\n");
+    write_test_file(directory, "per_cpu_count", "7,4,0,0\n");
+    assert(qb_read_irq_count_cached(path, root, QB_SGM41600_IRQ_LABEL,
+                                    &irq, &count) == 0);
+    assert(irq == 151 && count == 11);
+
+    write_test_file(directory, "per_cpu_count", "8,4,0,0\n");
+    assert(qb_read_irq_count_cached("/missing-interrupts", root,
+                                    QB_SGM41600_IRQ_LABEL, &irq, &count) == 0);
+    assert(irq == 151 && count == 12);
+
+    write_test_file(directory, "per_cpu_count", "8,broken\n");
+    assert(qb_read_irq_count_cached(path, root, QB_SGM41600_IRQ_LABEL,
+                                    &irq, &count) == 0);
+    assert(irq == -1 && count == 10);
+
+    write_test_file(directory, "per_cpu_count", "9,5,0,0\n");
+    write_test_file(directory, "actions", "unrelated\n");
+    assert(qb_read_irq_count_cached(path, root, QB_SGM41600_IRQ_LABEL,
+                                    &irq, &count) == 0);
+    assert(irq == -1 && count == 10);
+    assert(unlink(path) == 0);
+    assert(qb_read_irq_count_cached(path, root, QB_SGM41600_IRQ_LABEL,
+                                    &irq, &count) == -1);
+
+    snprintf(path, sizeof(path), "%sactions", directory);
+    assert(unlink(path) == 0);
+    snprintf(path, sizeof(path), "%sper_cpu_count", directory);
+    assert(unlink(path) == 0);
+    assert(rmdir(directory) == 0);
+    assert(rmdir(root) == 0);
+}
