+static int qb_scan_irq_count(const char *path, const char *label,
+                             unsigned long long *count, int *irq)
 {
     FILE *fp;
@@ -150,4 +151,12 @@ int qb_read_irq_count(const char *path, const char *label,
         if (!strstr(line, label) || !(cursor = strchr(line, ':')))
             continue;
+        if (irq) {
+            long number;
