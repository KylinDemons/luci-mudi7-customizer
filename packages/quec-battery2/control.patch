+            if (!errno && end == cursor && number >= 0 && number <= INT_MAX)
+                *irq = (int)number;
+        }
         cursor++;
         for (;;) {
@@ -176,4 +185,65 @@ int qb_read_irq_count(const char *path, const char *label,
 }
 
+int qb_read_irq_count(const char *path, const char *label,
+                      unsigned long long *count)
+{
+    return qb_scan_irq_count(path, label, count, NULL);
+}
+
+static int qb_read_irq_sysfs(const char *root, const char *label, int irq,
+                             unsigned long long *count)
+{
+    char path[128];
+    char buffer[256];
+    const char *cursor = buffer;
+    unsigned long long total = 0;
+    int length = snprintf(path, sizeof(path), "%s/%d/", root, irq);
+
+    if (length < 0 || (size_t)length >= sizeof(path) ||
+        qb_read_str(path, "actions", buffer, sizeof(buffer)) < 0 ||
+        strcmp(buffer, label) != 0)
+        return -1;
+    length = qb_read_str(path, "per_cpu_count", buffer, sizeof(buffer));
+    if (length <= 0 || (size_t)length >= sizeof(buffer) - 2)
+        return -1;
+
+    for (;;) {
+        unsigned long long value;
+        char *end;
+
+        if (!isdigit((unsigned char)*cursor))
+            return -1;
+        errno = 0;
+        value = strtoull(cursor, &end, 10);
+        if (errno || ULLONG_MAX - total < value)
+            return -1;
+        total += value;
+        if (!*end)
+            break;
+        if (*end != ',')
+            return -1;
+        cursor = end + 1;
+    }
+    *count = total;
+    return 0;
+}
+
+int qb_read_irq_count_cached(const char *path, const char *root,
+                             const char *label, int *irq,
+                             unsigned long long *count)
+{
+    int found_irq = -1;
+
+    if (*irq >= 0 && qb_read_irq_sysfs(root, label, *irq, count) == 0)
+        return 0;
+
+    *irq = -1;
+    if (qb_scan_irq_count(path, label, count, &found_irq) < 0)
+        return -1;
+    if (found_irq >= 0 && qb_read_irq_sysfs(root, label, found_irq, count) == 0)
+        *irq = found_irq;
+    return 0;
+}
+
 int qb_update_register(const char *dir, unsigned reg, unsigned mask,
                        unsigned value)
