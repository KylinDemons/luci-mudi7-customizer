#!/bin/sh /etc/rc.common
# Independent of mudi7-dashboard/gl_screen: persists across UI switches and screen sleep.
START=94
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/libexec/mudi7-customizer/battery_control.py daemon
    procd_set_param respawn
    procd_close_instance
}
