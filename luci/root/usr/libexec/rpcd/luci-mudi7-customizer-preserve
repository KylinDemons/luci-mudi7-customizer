#!/usr/bin/python3
"""Manage only the custom opkg feed entry in the A/B upgrade keep list."""
import hashlib
import json
import os
from pathlib import Path
import stat
import sys
import tempfile

RULE = Path('/lib/upgrade/keep.d/opkg')
ENTRIES = (b'/etc/opkg/customfeeds.conf', b'/etc/opkg/customfeeds.conf.d/')
METHODS = {'status': {}, 'set_enabled': {'enabled': True, 'revision': ''}}


def read_rule():
    if RULE.is_symlink():
        raise ValueError('The rule file must not be a symbolic link.')
    try:
        return RULE.read_bytes()
    except FileNotFoundError:
        return b''


def state(data):
    lines = {line.strip() for line in data.splitlines()}
    present = [entry in lines for entry in ENTRIES]
    return {'enabled': all(present), 'partial': any(present) and not all(present),
            'revision': hashlib.sha256(data).hexdigest()}


def set_enabled(args):
    enabled, revision = args.get('enabled'), args.get('revision')
    if not isinstance(enabled, bool) or not isinstance(revision, str):
        raise ValueError('Invalid switch state or rule revision.')
    data = read_rule()
    current = state(data)
    if current['revision'] != revision:
        raise ValueError('The rule file has been modified by another operation. Refresh the page and try again.')
    if enabled:
        lines = {line.strip() for line in data.splitlines()}
        missing = [entry for entry in ENTRIES if entry not in lines]
        result = data
        if missing:
            result += (b'\n' if data and not data.endswith(b'\n') else b'') + b''.join(entry + b'\n' for entry in missing)
    else:
        result = b''.join(line for line in data.splitlines(keepends=True) if line.strip() not in ENTRIES)
    if result == data:
        return current
    mode = stat.S_IMODE(RULE.stat().st_mode) if RULE.exists() else 0o644
    fd, name = tempfile.mkstemp(prefix='.mudi7-opkg-', dir=str(RULE.parent))
    try:
        with os.fdopen(fd, 'wb') as f:
            f.write(result)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(name, mode)
        os.replace(name, RULE)
    finally:
        if os.path.exists(name):
            os.unlink(name)
    return state(result)


def main():
    if sys.argv[1:] == ['list']:
        print(json.dumps(METHODS)); return
    if len(sys.argv) != 3 or sys.argv[1] != 'call' or sys.argv[2] not in METHODS:
        sys.exit(1)
    try:
        args = json.load(sys.stdin)
        if not isinstance(args, dict):
            raise ValueError('Invalid request.')
        result = state(read_rule()) if sys.argv[2] == 'status' else set_enabled(args)
        print(json.dumps({'ok': True, **result}, ensure_ascii=True))
    except (OSError, ValueError) as exc:
        print(json.dumps({'ok': False, 'error': str(exc)}, ensure_ascii=True))


if __name__ == '__main__':
    main()
