#!/usr/bin/python3
"""Narrow rpcd API for Mudi7 personalization."""
import fcntl
import json
from pathlib import Path
import shutil
import subprocess
import sys
import time

sys.dont_write_bytecode = True
DASH = Path('/usr/libexec/mudi7-customizer')
sys.path.insert(0, str(DASH))
import stock_i18n
from screen_i18n import get_language, set_language
from screen_modules import get_modules, set_modules
import battery_control as battery
from link_probe_config import get_probe_host, set_probe_host
from openclash_config import get_rule_group, set_rule_group

DISABLED = battery.ROOT / 'screen-disabled'
METHODS = {
    'status': {},
    'stock_i18n': {'action': ''},
    'set_screen': {'enabled': True},
    'set_screen_language': {'language': ''},
    'set_screen_modules': {'modules': []},
    'set_battery': {'enabled': True, 'threshold': 0},
    'set_rule_group': {'name': ''},
    'set_link_host': {'host': ''},
    'cleanup': {'confirm': True},
}


class TranslatableError(RuntimeError):
    def __init__(self, message, *params):
        super().__init__(message)
        self.params = params


def service(name, action):
    return subprocess.run(
        ['/etc/init.d/' + name, action], stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, timeout=5,
    ).returncode == 0


def run(what, *args):
    """Run a helper script, reporting failures in terms of what the user asked
    for rather than as a CalledProcessError repr in the LuCI status line."""
    try:
        subprocess.run(args, check=True, stdout=subprocess.DEVNULL, timeout=15)
    except subprocess.TimeoutExpired as exc:
        raise TranslatableError('%s timed out. Please try again later.', what) from exc
    except subprocess.CalledProcessError as exc:
        raise TranslatableError('%s failed (exit code %s). Please try again later.', what, exc.returncode) from exc


def read_int(path):
    try:
        return int(battery.read(path))
    except (OSError, ValueError):
        return None


def status():
    cfg = battery.load(battery.CONFIG, battery.DEFAULT)
    state = battery.load(battery.STATE, {})
    running = service('batterycontrol', 'running')
    gauge = read_int(battery.BAT / 'capacity')
    voltage = read_int(battery.BAT / 'voltage_now')
    online = read_int(battery.ONLINE)
    supported = battery.supported()
    fresh = 0 <= time.time() - state.get('updated', 0) < 25
    threshold = cfg['threshold']
    gauge_stop = next((n for n in range(101) if battery.gauge_to_display(n) >= threshold), None)
    if not supported:
        control = 'unsupported'
    elif not cfg['enabled']:
        control = 'off'
    elif not running or not fresh:
        control = 'inactive'
    elif state.get('error'):
        control = 'error'
    elif state.get('blocked'):
        control = 'held'
    elif online == 0:
        control = 'waiting'
    else:
        control = 'armed'
    return {
        'stock_i18n': stock_i18n.status(),
        'rule_group': get_rule_group(),
        'link_host': get_probe_host(),
        'screen_language': get_language(),
        'screen_modules': get_modules(),
        'screen_enabled': not DISABLED.exists() and service('homebutton', 'enabled'),
        'screen_active': service('mudi7-dashboard', 'running'),
        'stock_active': service('gl_screen', 'running'),
        'battery': {
            'enabled': cfg['enabled'], 'threshold': threshold, 'gauge_stop': gauge_stop,
            'control': control, 'supported': supported,
            'gauge': gauge,
            'display': battery.gauge_to_display(gauge) if gauge is not None else None,
            'online': online, 'voltage_mv': round(voltage / 1000) if voltage is not None else None,
            'current_ma': read_int(battery.BAT / 'current_now'),
        },
    }


def restore_pump():
    """Re-enable the charge pump on teardown.

    battery.release() deliberately leaves the pump alone: while the package is
    installed the vendor daemon re-mirrors it on the next plug event, and
    switching it back early can undo a gate that is still meant to hold. A
    cleanup is different -- nothing of ours is left to fix it later, and on
    supplies that actually reach the pump (9 V PD / PPS; its input sits behind
    an 11.5 V OVP, so 12 V heads never get there) charge_en=0 would keep the
    pack from charging until the next replug. Writing 1 cannot cost anything:
    the vendor daemon owns this pin and rewrites it on its own schedule.
    """
    try:
        if battery.read(battery.PUMP) != '1':
            battery.PUMP.write_text('1\n')
    except OSError:
        pass


def cleanup():
    if stock_i18n.BACKUP.exists():
        stock_i18n.operate('restore')
    run('Switch to the stock screen', DASH / 'toggle.sh', 'disable')
    if not service('batterycontrol', 'disable'):
        raise RuntimeError('Unable to disable charge limit service autostart.')
    # procd refuses to stop an instance that is already gone; only a service
    # that is still running after a failed stop is a real problem.
    if not service('batterycontrol', 'stop') and service('batterycontrol', 'running'):
        raise RuntimeError('The charge limit service failed to stop. Please try again.')

    # Wait for the daemon's shutdown handler. Keep its original voltage record
    # until the restoration has succeeded, including after an unclean exit.
    runtime = battery.STATE.parent
    if runtime.exists():
        deadline = time.monotonic() + 5
        with battery.DAEMON_LOCK.open('a') as daemon_lock, battery.LOCK.open('a') as lock:
            for fd in (daemon_lock, lock):
                while True:
                    try:
                        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                        break
                    except BlockingIOError:
                        if time.monotonic() >= deadline:
                            raise RuntimeError('The charge limit service has not stopped yet. Please try again.')
                        time.sleep(0.05)
            battery.release()
            restore_pump()
    labels = {'mudi7-dashboard': 'Custom screen', 'homebutton': 'Button switching', 'batterycontrol': 'Charge limit'}
    leftover = [labels[name] for name in labels if service(name, 'running')]
    if leftover:
        raise TranslatableError('These services are still running. Please try again later: %s', leftover)
    if not service('gl_screen', 'running'):
        raise RuntimeError('The stock screen has not started yet. Please try again.')

    for directory in (
        runtime, Path('/tmp/mudi7-customizer'),
        DASH / '__pycache__', battery.ROOT,
    ):
        try:
            shutil.rmtree(directory)
        except FileNotFoundError:
            pass


def handle(method, args):
    if method == 'status':
        return status()
    if method == 'stock_i18n':
        stock_i18n.operate(args.get('action'))
    elif method == 'set_screen_modules':
        set_modules(args.get('modules'))
    elif method == 'set_screen_language':
        set_language(args.get('language'))
    elif method == 'set_screen':
        enabled = args.get('enabled')
        if type(enabled) is not bool:
            raise ValueError('The screen switch must be a boolean.')
        run('Enable the custom screen' if enabled else 'Switch to the stock screen',
            DASH / 'toggle.sh', 'enable' if enabled else 'disable')
    elif method == 'set_battery':
        enabled, threshold = args.get('enabled'), args.get('threshold')
        if type(enabled) is not bool or type(threshold) is not int or not 50 <= threshold <= 100:
            raise ValueError('The charge target must be an integer from 50 to 100.')
        battery.LOCK.parent.mkdir(parents=True, exist_ok=True)
        battery.ensure_daemon()
        battery.operate('configure', (enabled, threshold))
    elif method == 'set_rule_group':
        set_rule_group(args.get('name'))
    elif method == 'set_link_host':
        set_probe_host(args.get('host'))
    elif method == 'cleanup':
        if args.get('confirm') is not True:
            raise ValueError('Please confirm cleanup first.')
        cleanup()
    return status()


def main():
    if sys.argv[1:] == ['list']:
        print(json.dumps(METHODS))
        return
    if len(sys.argv) != 3 or sys.argv[1] != 'call' or sys.argv[2] not in METHODS:
        sys.exit(1)
    method = sys.argv[2]
    try:
        # Serialize LuCI writes without creating a state file that cleanup
        # would have to unlink while another RPC is waiting on it.
        with open(__file__, 'rb') as lock:
            flags = fcntl.LOCK_SH if method == 'status' else fcntl.LOCK_EX
            fcntl.flock(lock, flags | fcntl.LOCK_NB)
            args = json.load(sys.stdin) if method != 'status' else {}
            if not isinstance(args, dict):
                raise ValueError('Invalid request parameters.')
            print(json.dumps({'ok': True, **handle(method, args)}, ensure_ascii=True))
    except BlockingIOError:
        print(json.dumps({'ok': False, 'error': 'Another operation is running. Please try again later.'}))
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as exc:
        print(json.dumps({'ok': False, 'error': str(exc), 'error_params': getattr(exc, 'params', [])}))


if __name__ == '__main__':
    main()
